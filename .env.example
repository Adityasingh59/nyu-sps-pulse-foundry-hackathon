# Variables are read from the shell; this file is a reference, not auto-loaded.
# With no API key, the official local Codex CLI uses its normal ChatGPT sign-in.
# Check: npm run provider:status. Sign in only if needed: npm run provider:login.
CODEX_MODEL=gpt-6.1-sol
# Optional binary override (no credential data):
# TABLESIGNAL_CODEX_PATH=/absolute/path/to/codex

# Alternative live adapter, selected when a server-side API key is configured:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PORT=3001
TABLESIGNAL_DB_PATH=data/tablesignal.sqlite
# Up to20 questions,2 concurrent observations,40 attempts/run by default.
# CLI allowance is charged to the signed-in account; no credits are purchased.
MAX_REQUESTS_PER_RUN=40
MAX_OUTPUT_TOKENS=900
# Default timeout:150000ms for CLI;45000ms for Responses API.
PROVIDER_TIMEOUT_MS=150000

# --- Cloud app (Next.js on Vercel, `npm run cloud:dev` / `cloud:build`) ---
# Public by design (sent to the browser); data is protected by RLS. Never put a
# service-role/secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
