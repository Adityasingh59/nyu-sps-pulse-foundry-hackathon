{
  "name": "tablesignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "cloud:dev": "next dev --port 3000",
    "cloud:build": "next build",
    "cloud:start": "next start --port 3000",
    "test": "tsx --test tests/*.test.ts",
    "provider:status": "codex login status",
    "provider:login": "codex login",
    "setup:nyc": "tsx scripts/setup-nyc.ts",
    "run:nyc": "tsx scripts/run-nyc.ts",
    "rerun:nyc": "tsx scripts/run-nyc.ts --rerun",
    "up": "node scripts/local.mjs up",
    "down": "node scripts/local.mjs down",
    "local:status": "node scripts/local.mjs status"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "optionalDependencies": {
    "@openai/codex": "^0.163.0"
  }
}
